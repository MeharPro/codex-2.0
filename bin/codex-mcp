#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_ROOT="${SCRIPT_DIR:h}"
ENV_FILE="${CODEX_MCP_ENV_FILE:-$PROJECT_ROOT/.env}"

if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

TUNNEL_CLIENT="${TUNNEL_CLIENT:-${commands[tunnel-client]:-}}"
ALIAS="${CODEX_MCP_ALIAS:-codex-tool-gateway}"
PROFILE="${CODEX_MCP_PROFILE:-codex-tool-gateway}"
CONFIG_DIR="${CODEX_MCP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/codex-mcp}"
WORKSPACE_FILE="${CODEX_MCP_WORKSPACE_FILE:-$CONFIG_DIR/workspace}"
RUNTIME_API_KEY_FILE="${RUNTIME_API_KEY_FILE:-$CONFIG_DIR/runtime-api-key}"
PYTHON_BIN="${PYTHON_BIN:-$PROJECT_ROOT/.venv/bin/python}"
GATEWAY_PATH="$PROJECT_ROOT/gateway.py"
MCP_COMMAND="${CODEX_MCP_COMMAND:-${(q)PYTHON_BIN} ${(q)GATEWAY_PATH}}"

if [[ -z "$TUNNEL_CLIENT" || ! -x "$TUNNEL_CLIENT" ]]; then
  print -u2 "codex-mcp: tunnel-client was not found."
  print -u2 "Set TUNNEL_CLIENT in $ENV_FILE or add it to PATH."
  exit 1
fi

summarize_status() {
  "$TUNNEL_CLIENT" runtimes status "$ALIAS" --json | python3 -c '
import json
import sys

data = json.load(sys.stdin)
process = data.get("process") or {}
local = data.get("local") or {}

ready = bool(data.get("ready") or local.get("runtime_state") == "ready")
healthy = bool(data.get("healthy"))
pid = data.get("pid") or process.get("pid")
tunnel_id = data.get("tunnel_id") or process.get("tunnel_id")

print("codex-mcp: {}".format("ready" if ready else "not ready"))
print("  healthy: {}".format(str(healthy).lower()))
print("  pid: {}".format(pid or "-"))
print("  tunnel: {}".format(tunnel_id or "-"))
'
}

require_start_config() {
  if [[ -z "${TUNNEL_ID:-}" || "$TUNNEL_ID" == "tunnel_REPLACE_ME" ]]; then
    print -u2 "codex-mcp: set TUNNEL_ID in $ENV_FILE"
    exit 1
  fi
  if [[ ! -x "$PYTHON_BIN" ]]; then
    print -u2 "codex-mcp: Python environment not found at $PYTHON_BIN"
    print -u2 "Run the installation steps in README.md."
    exit 1
  fi
  if [[ ! -f "$RUNTIME_API_KEY_FILE" ]]; then
    print -u2 "codex-mcp: runtime API key file not found: $RUNTIME_API_KEY_FILE"
    exit 1
  fi

  local key_mode
  key_mode="$(stat -f '%Lp' "$RUNTIME_API_KEY_FILE" 2>/dev/null || true)"
  if [[ -n "$key_mode" && "$key_mode" != "600" ]]; then
    print -u2 "codex-mcp: refusing insecure key permissions ($key_mode)."
    print -u2 "Run: chmod 600 ${(q)RUNTIME_API_KEY_FILE}"
    exit 1
  fi
}

start_gateway() {
  require_start_config

  local requested_workspace="${1:-$PWD}"
  requested_workspace="$(cd "$requested_workspace" && pwd -P)"
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"

  local existing_workspace=""
  if [[ -f "$WORKSPACE_FILE" ]]; then
    existing_workspace="$(<"$WORKSPACE_FILE")"
  fi

  if [[ "$existing_workspace" != "$requested_workspace" ]]; then
    "$TUNNEL_CLIENT" runtimes stop "$ALIAS" --json >/dev/null 2>&1 || true
  fi

  local workspace_tmp
  workspace_tmp="$(mktemp "${WORKSPACE_FILE}.XXXXXX")"
  print -r -- "$requested_workspace" > "$workspace_tmp"
  chmod 600 "$workspace_tmp"
  mv "$workspace_tmp" "$WORKSPACE_FILE"

  "$TUNNEL_CLIENT" runtimes connect \
    --alias "$ALIAS" \
    --profile "$PROFILE" \
    --tunnel-id "$TUNNEL_ID" \
    --runtime-api-key "file:$RUNTIME_API_KEY_FILE" \
    --mcp-command "$MCP_COMMAND" \
    --json >/dev/null
  summarize_status
}

case "${1:-start}" in
  start)
    start_gateway "${2:-$PWD}"
    ;;
  status)
    summarize_status
    ;;
  stop)
    "$TUNNEL_CLIENT" runtimes stop "$ALIAS" --json >/dev/null
    print "codex-mcp: stopped"
    ;;
  restart)
    "$TUNNEL_CLIENT" runtimes stop "$ALIAS" --json >/dev/null 2>&1 || true
    start_gateway "${2:-$PWD}"
    ;;
  *)
    if [[ -d "${1:-}" ]]; then
      start_gateway "$1"
    else
      print -u2 "Usage: codex-mcp [start [folder]|status|stop|restart [folder]|folder]"
      exit 2
    fi
    ;;
esac
