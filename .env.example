# Copy this file to .env. Never commit .env.
#
# Create the tunnel at:
# https://platform.openai.com/settings/organization/tunnels
#
# Create your own runtime API key at:
# https://platform.openai.com/settings/organization/api-keys
#
# Do not paste that key into this file. Save it at RUNTIME_API_KEY_FILE with
# mode 600. The only credential-like value in .env is the provider-generated
# tunnel ID.
TUNNEL_ID=tunnel_REPLACE_ME
RUNTIME_API_KEY_FILE=$HOME/.config/codex-mcp/runtime-api-key

# Optional overrides:
# TUNNEL_CLIENT=$HOME/.local/bin/tunnel-client
# PYTHON_BIN=/absolute/path/to/codex-2.0/.venv/bin/python
# CODEX_MCP_ALIAS=codex-tool-gateway
# CODEX_MCP_PROFILE=codex-tool-gateway
# CODEX_MCP_CONFIG_DIR=$HOME/.config/codex-mcp
